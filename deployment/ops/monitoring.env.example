# Copiar para /etc/blackhouse/monitoring.env e preencher valores.
# chmod 600 /etc/blackhouse/monitoring.env

# Telegram Bot API — criar bot em @BotFather e obter chat_id via getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Limites de alerta (opcional — defaults no watchdog.sh)
# CPU_THRESHOLD=90
# RAM_THRESHOLD=90
# DISK_THRESHOLD=85
# ALERT_COOLDOWN_SEC=300
