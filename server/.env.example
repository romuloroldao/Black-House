# Copie para server/.env ou gere tudo com: npm run setup:local
# Ordem de carga no Node: .env na raiz, depois server/.env (este sobrescreve).

JWT_SECRET=defina_um_segredo_com_pelo_menos_32_caracteres_aleatorios
DB_PASSWORD=sua_senha_postgres
# Com Docker (docker-compose.yml na raiz): utilizador app_user, senha blackhouse_local_2026
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blackhouse_db
DB_USER=app_user

# Opcional: uma única URL (ex.: Postgres gerido / Docker cloud) em vez de DB_* acima
# DATABASE_URL=postgres://app_user:senha@host:5432/blackhouse_db

# SSL para Postgres remoto (ex.: RDS, Neon, Supabase pooler)
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

PORT=3001
API_URL=http://localhost:3001

# URL pública do frontend (link «esqueci minha senha» no email)
FRONTEND_URL=http://localhost:8080

NODE_ENV=development

# Emails automáticos (confirmação, reset de senha) — remetente padrão do sistema
AUTOMATED_EMAIL_FROM="Black House <nao-responda@blackhouse.app.br>"
#
# Em produção: sem RESEND_API_KEY ou SMTP_HOST, confirmação de conta e «esqueci a senha» não enviam correio (503).
# Opcional local: envio de email (um dos dois)
# Resend — https://resend.com (RESEND_FROM opcional; se vazio, usa AUTOMATED_EMAIL_FROM)
# RESEND_API_KEY=re_...
# RESEND_FROM="Black House <nao-responda@blackhouse.app.br>"
#
# Ou SMTP genérico (usa nodemailer; SMTP_FROM opcional)
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Black House <nao-responda@blackhouse.app.br>"

# Opcional: logar TODAS as queries Postgres (stack + logger) — só para debug; degrada muito a API
# ENABLE_QUERY_INTERCEPTOR=true

# Opcional: IA para importação de PDF
# AI_PROVIDER=gemini
# GEMINI_API_KEY=

# Visão (foto de refeição) — independente do provider de texto (ex.: groq)
# AI_VISION_PROVIDER=gemini
# AI_VISION_API_KEY=   # ou reutilizar GEMINI_API_KEY
# AI_VISION_MODEL=gemini-2.5-pro
# RATE_LIMIT_MEAL_PHOTO_MAX=10
# RATE_LIMIT_MEAL_PHOTO_WINDOW_MS=3600000

# Opcional: Asaas (fallback global — pagamentos quando o coach não tem chave em Configurações)
# ENABLE_ASAAS=false
# ASAAS_API_KEY=
# ASAAS_ENVIRONMENT=production
# ASAAS_ALLOW_GLOBAL_FALLBACK=true
# ASAAS_SHARED_ACCOUNT=true
# ASAAS_SHARED_WEBHOOK_COACH_ID=
# ASAAS_WEBHOOK_TOKEN=
# ASAAS_WEBHOOK_EMAIL=nao-responda@blackhouse.app.br

# Obrigatório em produção para guardar chaves Asaas por coach (Configurações → Integrações).
# Gere uma string aleatória longa (mínimo 32 caracteres), ex.: openssl rand -base64 48
# Nunca commits nem partilhe este valor — serve para AES-256-GCM das chaves na base de dados.
# ASAAS_COACH_SECRETS_KEY=
