# Copie para e2e/.env e preencha com contas de teste (coach + aluno com email confirmado).
# Nunca commite e2e/.env.

# Frontend (Vite dev ou produção)
E2E_BASE_URL=http://127.0.0.1:8080

# API (deve bater com VITE_API_URL do frontend)
E2E_API_URL=http://127.0.0.1:3001

# Aluno — portal /portal-aluno
E2E_STUDENT_EMAIL=aluno@exemplo.com
E2E_STUDENT_PASSWORD=sua_senha

# Coach — painel /
E2E_COACH_EMAIL=coach@exemplo.com
E2E_COACH_PASSWORD=sua_senha

# Opcional: não subir Vite (já está a correr noutro terminal)
# E2E_SKIP_WEBSERVER=1
